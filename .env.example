# Copie este arquivo para .env e coloque a senha do root do seu MySQL.
# O banco "greencode" e criado sozinho pelo "npm run dev".
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/greencode"

# Porta HTTP da API.
PORT=3000

# Segredo usado para assinar os tokens JWT.
JWT_SECRET="troque-este-segredo"
