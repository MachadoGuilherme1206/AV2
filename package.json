{
  "name": "greencode",
  "version": "1.0.0",
  "description": "Sistema de gestao de logistica reversa de residuos eletronicos",
  "scripts": {
    "dev": "npm install && prisma generate && tsc && prisma migrate reset --force && npm run iniciar",
    "iniciar": "node --env-file-if-exists=.env out/server.js",
    "testar": "tsc && node --test \"out/testes/unitarios/*.test.js\""
  },
  "prisma": {
    "schema": "./prisma/schema/",
    "seed": "node --env-file-if-exists=.env out/seed.js"
  },
  "keywords": [
    "logistica-reversa",
    "residuos-eletronicos",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "prisma": "^6.19.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
